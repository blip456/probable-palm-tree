# Supabase connection (server-side only — do NOT prefix the key with NEXT_PUBLIC_)
# Find these in your Supabase project: Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Without these set, the app falls back to a per-instance in-memory store,
# which does NOT persist across serverless instances on Vercel.
